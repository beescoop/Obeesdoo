<odoo>
    <!--
        Add the display_attendees toggle to the existing shift settings form
    -->
    <record id="view_shift_display_attendees_settings" model="ir.ui.view">
        <field name="name">Shift Display Attendees Settings</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="shift_portal.view_website_shift_config_irregular"
        />
        <field name="priority" eval="35" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='shift_settings_block']" position="inside">
                <h2 id="shift_portal_display_settings_title">Shift: Portal Display</h2>
                <div
                    class="row mt16 o_settings_container"
                    id="shift_portal_display_settings"
                >
                    <div class="col-12 col-md-6 o_setting_box">
                        <div class="row">
                            <div class="col-12">
                                <div class="o_setting_left_pane">
                                    <field name="display_attendees_on_portal" />
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="display_attendees_on_portal" />
                                    <span
                                        class="fa fa-lg fa-globe"
                                        title="Values set here are website-specific."
                                        groups="website.group_multi_website"
                                    />
                                    <div class="text-muted">
                                        Display names of registered attendees
                                        on shift subscription modals
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
