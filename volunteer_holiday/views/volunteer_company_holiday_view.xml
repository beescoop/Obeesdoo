<odoo>

    <record id="volunteer_company_holiday_view_tree" model="ir.ui.view">
        <field name="name">Holiday List</field>
        <field name="model">volunteer.company.holiday</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="company_id" options="{'no_create':True}" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="volunteer_company_holiday_action" model="ir.actions.act_window">
        <field name="name">Company Holiday</field>
        <field name="res_model">volunteer.company.holiday</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
