<odoo>
    <record id="volunteer_volunteer_leave_view_tree" model="ir.ui.view">
        <field name="name">Volunteer Leaves List</field>
        <field name="model">volunteer.volunteer.leave</field>
        <field name="arch" type="xml">
            <tree default_order="start_date asc">
                <field name="volunteer_id" />
                <field name="type_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="company_id" options="{'no_create':True}" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="volunteer_volunteer_leave_view_form" model="ir.ui.view">
        <field name="name">Volunteer Leaves Form</field>
        <field name="model">volunteer.volunteer.leave</field>
        <field name="arch" type="xml">
            <form string="Volunteer Leave">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="type_id" string="Leave Type" />
                            <field name="type_id" />
                        </h1>
                    </div>
                    <group>
                        <group name="group_left">
                            <label for="start_date" string="Period" />
                            <div class="row d-flex">
                                <div class="col-4">
                                    <field
                                        name="start_date"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_end_date': 'end_date'}"
                                    />
                                </div>
                                <div class="col-1">
                                    <i
                                        class="fa fa-long-arrow-right"
                                        aria-label="Arrow icon"
                                        title="Arrow"
                                    />
                                </div>
                                <div class="col-4">
                                    <field
                                        name="end_date"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_start_date': 'start_date'}"
                                    />
                                </div>
                            </div>
                        </group>
                        <group name="group_right">
                            <field
                                name="company_id"
                                string="Company"
                                options="{'no_create':True}"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="volunteer_volunteer_leave_view_search" model="ir.ui.view">
        <field name="model">volunteer.volunteer.leave</field>
        <field name="arch" type="xml">
            <search string="Volunteer Leave Search">
                <filter
                    name="filter_future"
                    string="Future"
                    domain="[('start_date', '>=', context_today().strftime('%Y-%m-%d'))]"
                />
            </search>
        </field>
    </record>

    <record id="volunteer_volunteer_leave_action" model="ir.actions.act_window">
        <field name="name">Volunteer Leaves</field>
        <field name="res_model">volunteer.volunteer.leave</field>
        <field name="context">{"search_default_filter_future": 1}</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
