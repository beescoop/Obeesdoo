<odoo>
    <record id="volunteer_volunteer_leave_view_tree" model="ir.ui.view">
        <field name="name">Volunteer Leaves List</field>
        <field name="model">volunteer.volunteer.leave</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="volunteer_id" />
                <field name="type_id" />
                <field name="start_date" />
                <field name="end_date" />
            </tree>
        </field>
    </record>

    <record id="volunteer_volunteer_leave_action" model="ir.actions.act_window">
        <field name="name">Volunteer Leaves</field>
        <field name="res_model">volunteer.volunteer.leave</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
