<odoo>
    <record id="volunteer_shift_generator_view_form_extend" model="ir.ui.view">
        <field
            name="name"
        >Shift Generator: Add info about holiday-cancellable shifts</field>
        <field name="model">volunteer.shift.recurrent.generator</field>
        <field name="inherit_id" ref="volunteer.volunteer_shift_generator_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//group[field[@name='until_date']]" position="before">
                <group>
                    <group>
                        <field
                            name="is_maintained_during_holiday"
                            widget="boolean_toggle"
                        />
                    </group>
                </group>
            </xpath>
            <xpath
                expr="//group[field[@name='is_maintained_during_holiday']]"
                position="before"
            >
                <xpath expr="//group[field[@name='until_date']]" position="move">
                </xpath>
            </xpath>

        </field>
    </record>
</odoo>
