<odoo>
    <record id="volunteer_volunteer_leave_type_view_tree" model="ir.ui.view">
        <field name="name">Leave Type List</field>
        <field name="model">volunteer.volunteer.leave.type</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
                <field name="description" />
                <field name="company_id" options="{'no_create':True}" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="volunteer_volunteer_leave_type_action" model="ir.actions.act_window">
        <field name="name">Leave Types</field>
        <field name="res_model">volunteer.volunteer.leave.type</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
