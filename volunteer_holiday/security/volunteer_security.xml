<odoo>
    <record id="volunteer_company_holiday_rule_company" model="ir.rule">
        <field name="name">Volunteer Company Holiday: Company Access</field>
        <field name="model_id" ref="model_volunteer_company_holiday" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]
        </field>
    </record>
    <record id="volunteer_volunteer_leave_rule_company" model="ir.rule">
        <field name="name">Volunteer Leaves: Company Access</field>
        <field name="model_id" ref="model_volunteer_volunteer_leave" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]
        </field>
    </record>
    <record id="volunteer_volunteer_leave_type_rule_company" model="ir.rule">
        <field name="name">Volunteer Leave Type: Company Access</field>
        <field name="model_id" ref="model_volunteer_volunteer_leave_type" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]
        </field>
    </record>
</odoo>
