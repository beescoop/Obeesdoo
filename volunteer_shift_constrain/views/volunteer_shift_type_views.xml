<odoo>

    <record id="volunteer_shift_type_constrain_view_tree" model="ir.ui.view">
        <field name="name">Shift Type with Constrain</field>
        <field name="model">volunteer.shift.type</field>
        <field name="inherit_id" ref="volunteer.volunteer_shift_type_view_tree" />
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="shift_constrain_id" />
            </field>
        </field>
    </record>


