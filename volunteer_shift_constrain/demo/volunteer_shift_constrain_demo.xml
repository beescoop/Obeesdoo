<odoo>

    <record model="volunteer.shift.constrain" id="shift_constrain_languages">
        <field name="name">Languages</field>
        <field
            name="description"
        >Need at least one french speaker and one english speaker</field>
    </record>

    <record model="volunteer.shift.skill.rule" id="skill_rule_french">
        <field name="skill_id" ref="volunteer.volunteer_skill_demo_french" />
        <field name="required_number">1</field>
        <field name="shift_constrain_id" ref="shift_constrain_languages" />
    </record>

    <record model="volunteer.shift.skill.rule" id="skill_rule_english">
        <field name="skill_id" ref="volunteer.volunteer_skill_demo_english" />
        <field name="required_number">1</field>
        <field name="shift_constrain_id" ref="shift_constrain_languages" />
    </record>

</odoo>
