<templates id="template" xml:space="preserve">

    <t
        t-name="ActionpadWidgetCanShop"
        t-inherit="point_of_sale.ActionpadWidget"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//t[@t-esc='props.partner.name']" position="after">
            <t t-if="props.partner.can_shop">
                <div
                    name="can-shop-status"
                    class="coop_status can_shop"
                >(Can shop)</div>
            </t>
            <t t-else="">
                <div
                    name="cannot-shop-status"
                    class="coop_status cannot_shop"
                >(Cannot shop)</div>
            </t>
        </xpath>
    </t>

</templates>
