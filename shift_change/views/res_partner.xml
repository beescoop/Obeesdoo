<odoo>

     <record model="ir.ui.view" id="res_partner_shift_change_button">
        <field name="name">Contact: Change Shift Button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="shift.super_coop_partner_inherited_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='temporary_exempt']" position="after">
                <button
                    name="button_change_shift"
                    string="Change a Shift"
                    class="oe_highlight"
                    type="object"
                    groups="shift.group_shift_management"
                    attrs="{
                        'invisible': [
                            '|',
                            ('working_mode','!=','regular'),
                            ('state','in',['unsubscribed','resigning'])
                        ]
                     }"
                />
            </xpath>
        </field>
    </record>

</odoo>
