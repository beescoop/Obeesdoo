<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Action to open change shift -->

    <record model="ir.actions.act_window" id="action_shift_change">
        <field name="name">Shift changes</field>
        <field name="res_model">shift.change</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Top menu items -->

    <menuitem id="menu_change_top" name="Shift Changes" parent="shift.menu_root" />
    <menuitem
        id="menu_change"
        name="Shift Changes"
        parent="menu_change_top"
        action="action_shift_change"
    />

</odoo>
