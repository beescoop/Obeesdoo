<odoo>
    <record id="volunteer_shift_view_form_extend" model="ir.ui.view">
        <field name="name">Shift: add attendance status for participation</field>
        <field name="model">volunteer.shift</field>
        <field name="inherit_id" ref="volunteer.volunteer_shift_view_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="attendance_state" options="{'no_create':True}" />
            </field>
            <field name="cancellation_date" position="after">
                <field name="attendance_status_id" options="{'no_create':True}" />
            </field>
            <field name="attendance_status_id" position="after">
                <field name="attendance_date" />
            </field>
        </field>
    </record>
</odoo>
