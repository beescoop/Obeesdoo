<odoo>
    <record id="volunteer_shift_attendance_status_view_tree" model="ir.ui.view">
        <field name="name">Attendance Status List</field>
        <field name="model">volunteer.shift.attendance.status</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
                <field name="description" />
                <field name="company_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="volunteer_shift_attendance_status_action" model="ir.actions.act_window">
        <field name="name">Attendance Status</field>
        <field name="res_model">volunteer.shift.attendance.status</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
