<odoo>
    <record id="volunteer_shift_participation_view_tree_extend" model="ir.ui.view">
        <field
            name="name"
        >Participation: add attendance status for participation</field>
        <field name="model">volunteer.shift.participation</field>
        <field
            name="inherit_id"
            ref="volunteer.volunteer_shift_participation_view_tree"
        />
        <field name="arch" type="xml">
            <field name="cancellation_date" position="after">
                <field name="attendance_status_id" options="{'no_create':True}" />
                <field name="attendance_date" />
            </field>
        </field>
    </record>
</odoo>
