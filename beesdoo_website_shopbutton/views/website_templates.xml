<odoo>
    <template id="webshop_button_topmenu" inherit_id="website.layout">
        <xpath
            expr="//header//ul[@id='top_menu']/li[hasclass('dropdown')]"
            position="before"
        >
            <li class="nav-item">
                <a
                    id="website-shopbutton"
                    class="nav-link website-shopbutton"
                    t-att-href="request.env.user.webshop_url"
                >
                    <i class="fa fa-shopping-cart" /> Webshop
                </a>
            </li>
        </xpath>
    </template>
</odoo>
