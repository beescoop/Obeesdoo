#. module: shift_solidarity_portal
#: model_terms:ir.ui.view,arch_db:shift_solidarity_portal.help_text_all_shifts_solidarity_offer
msgid ""
"<strong>Info!</strong>\n"
"            On this page you can choose to subscribe to a shift as a solidarity\n"
"            shift. If you select one of them, you will have to attend it or to\n"
"            cancel it soon enough, via the \"My shifts\" page."
msgstr ""

#. module: shift_solidarity_portal
#: model_terms:ir.ui.view,arch_db:shift_solidarity_portal.help_text_underpopulated_solidarity_offer
msgid ""
"<strong>Info!</strong>\n"
"            On this page you can choose to subscribe to a shift that is\n"
"            underpopulated, as a solidarity shift. If you select one of them, you\n"
"            will have to attend it or to cancel it soon enough, via the \"My shifts\"\n"
"            page. If you cannot attend any of those on this list, please click on\n"
"            the button at the bottom of the page to see all available shifts."
msgstr ""

