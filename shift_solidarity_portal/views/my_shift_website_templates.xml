<odoo>

    <!-- Add buttons to change shift -->
    <template
        id="my_shift_next_shifts_solidarity_offer"
        name="My shifts: Next Shift with solidarity cancel button"
        inherit_id="shift_portal.my_shift_next_shifts"
    >
        <xpath expr="//div[hasclass('card-body', 'clearfix')]" position="inside">
            <a
                t-if="shift.is_solidarity
                    and shift.state != 'cancel'
                    and is_solidarity_enabled
                    and shift.id"
                t-attf-href="/my/shift/solidarity/offer/cancel/{{ shift.solidarity_offer_ids[0].id }}"
                class="btn btn-primary btn-sm ml-2"
            >
                Cancel solidarity
            </a>
        </xpath>
    </template>

</odoo>
