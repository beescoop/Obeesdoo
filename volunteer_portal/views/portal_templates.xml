<odoo>

  <!--* "My Shifts" card + counter in /my (Home portal page) -->

  <template
        id="portal_my_home"
        inherit_id="portal.portal_my_home"
        priority="100"
        name="Show My Shifts"
        customize_show="True"
    >
  <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
    <t t-call="portal.portal_docs_entry">
      <t t-set="title">My shifts</t>
      <!-- Link button redirecting to "My shifts"-->
      <t t-set="url" t-value="'/my/volunteer-shifts'" />
      <!-- Shifts participations counter (number) in Home (/my) -->
      <!--!TOFIX: When no shifts yet -> counter / badge does not appear -> needs to display badge + counter (0) -->
      <!--? Idea: badge/ counter could display only upcoming shifts number -->
      <t t-set="placeholder_count" t-value="'volunteer_participation_count'" />
    </t>
  </xpath>
</template>

<!--* All shifts participations for this volunteer, split into upcoming & past shifts (/my/volunteer-shifts)-->

<template id="my_shifts" name="My shifts">

  <!-- Template will inherit from Odoo’s default portal layout (header + footer)-->

  <t t-call="portal.portal_layout">

    <h1>My shifts</h1>

    <!--* Success message on cancel participation -->

    <div
                class="alert alert-success"
                role="status"
                t-if="success.get('cancel_participation')"
            >
      <t t-out="success['cancel_participation']" />
    </div>

    <!--* Error message on cancel participation -->

    <div
                class="alert alert-danger"
                role="alert"
                t-if="errors.get('cancel_participation')"
            >
      <t t-out="errors['cancel_participation']" />
    </div>

    <!--* Upcoming shifts -->

    <section aria-labelledby="upcoming-title">

      <h2 id="upcoming-title">_("My upcoming shifts") </h2>

      <!-- Conditional rendering -> only if there are upcoming shift participations for volunteer -->

      <t t-if="upcoming_participations">

        <!--TODO when writing the "Register for a shift" form/controller: volunteer registered themselves via portal should be automatically set to "website"-->
        <!--TODO When shift is canceled either by admin or user: if the latter, should be greyed out / removed in the list of upcoming shifts -->

        <ul class="list-unstyled">
          <li t-foreach="upcoming_participations" t-as="participation">
            <article>

              <!--TODO: Shift name + link to detail (to change later)-->
              <h3>
                <a t-attf-href="/my/volunteer-shifts/#{participation.id}">
                  <span t-field="participation.shift_id.display_name" />
                </a>
              </h3>

              <!-- Key/value pair but no displayed labels ("visually-hidden" label for screen readers) -->
              <dl>
                <!--? Find how to display only date then hours without date -->
                <dt class="visually-hidden">Shift starttime</dt>
                <dd><span t-field="participation.shift_start_time" /></dd>

                <dt class="visually-hidden">Shift endtime</dt>
                <dd><span t-field="participation.shift_end_time" /></dd>

                <dt class="visually-hidden">Shift status</dt>
                <dd><span
                                            t-field="participation.registration_state"
                                            t-attf-class="badge #{'bg-danger'if participation.registration_state == 'canceled' else 'bg-success'}"
                                        /></dd>
              </dl>


              <!-- Only CONFIRMED state + upcoming participations can be canceled -->
              <t
                                    t-if="participation.registration_state == 'confirmed' and participation.shift_id.start_time &gt;= now"
                                >

                <!-- Cancel shift participation form -->

                <form action="/my/volunteer-shifts" method="post">
                  <!-- t-att-$name (not a string, no "f")  -->
                  <input
                                            name="csrf_token"
                                            type="hidden"
                                            t-att-value="request.csrf_token()"
                                        />
                  <input name="action" type="hidden" value="cancel_participation" />
                  <!-- t-att-$name (not a string, no "f")          -->
                  <input
                                            name="participation_id"
                                            type="hidden"
                                            t-att-value="participation.id"
                                        />

                  <button
                                            type="submit"
                                            class="btn btn-danger"
                                        >Cancel participation</button>
                </form>
              </t>
            </article>
          </li>
        </ul>
      </t>


      <!-- Conditional rendering -> if no shift participation for volunteer-->
      <t t-else="">
        <div class="alert alert-warning" role="alert">
          No upcoming shifts registrations!
        </div>
        <!--TODO : add a "Register for a shift" button that redirects to available shifts -->
      </t>
    </section>




    <!--* Past shifts -->

    <!--? Accessibility:: see https://www.w3.org/WAI/tutorials/tables/caption-summary/ and adapt -->

    <div class="col-md-6">

      <section aria-labelledby="past-title">
        <!-- View is closed by default -->
        <details>

          <summary> <h2 id="past-title"> Past shifts </h2></summary>

          <!-- Conditional rendering = only if there are past shifts participations for usr, it's rendered -->
          <t t-if="past_participations" t-call="portal.portal_table">
            <!-- Accessibility: added "caption" [specifies the caption (or title) of a table, providing the table an accessible name or accessible description.]
            https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/caption + https://getbootstrap.com/docs/5.0/helpers/visually-hidden/-->
            <caption class="visually-hidden"> My past shifts</caption>
            <thead>
              <tr>
                <th scope="col">What shift?</th>
                <th scope="col">From when?</th>
                <th scope="col">Until when?</th>
                <th scope="col">How were you registered?</th>
              </tr>
            </thead>
            <tbody>

              <!--* Past shifts past participations list for usr- for each) -->

              <tr t-foreach="past_participations" t-as="participation">

                <!--*Link redirecting to single shift participation details -->

                <td><a t-attf-href="/my/volunteer-shifts/#{participation.id}"><span
                                                t-field="participation.shift_id.display_name"
                                            /></a></td>
                <td><span t-field="participation.shift_start_time" /></td>
                <td><span t-field="participation.shift_end_time" /></td>
                <td><span t-field="participation.registration_type" /></td>

              </tr>
            </tbody>
          </t>

          <!-- Conditional rendering => if no past shift participation for usr -->

          <t t-else="">
            <div class="alert alert-warning" role="alert">
              No past shifts registrations!
            </div>
          </t>
        </details>
      </section>
    </div>

  </t>
</template>


<!--* Shift participation detail for this volunteer (/my/volunteer-shifts/{participation_id})-->

<!-- Adapted from Odoo15 Book -> to adapt  -->

<template id="my_shift_participation" name="My shift participation details">

  <!-- Portal layout -->
  <t t-call="portal.portal_layout">

    <h1>Shift details / Actions on participation</h1>

    <!--* Success message on cancel participation -->

    <div
                class="alert alert-success"
                role="status"
                t-if="success.get('cancel_participation')"
            >
      <t t-out="success['cancel_participation']" />
    </div>

    <!--* Error message on cancel participation -->

    <div
                class="alert alert-danger"
                role="alert"
                t-if="errors.get('cancel_participation')"
            >
      <t t-out="errors['cancel_participation']" />
    </div>

    <div class="row">
      <div class="col">
        <h2 class="text-truncate" t-field="participation.shift_id.display_name"> </h2>
      </div>

      <div class="col text-end">
        <span
                        t-field="participation.registration_state"
                        t-attf-class="badge #{'bg-danger'if participation.registration_state == 'canceled' else 'bg-success'}"
                        title="Shift state"
                    />
      </div>


      <!--? TO PUT IN DETAILED SHIFT VIEW - TOGGLEABLE - OR MENU -->
      <!-- <span t-field="participation.registration_type"/> -->
      <!-- <span t-field="participation.registration_date"/>-->
      <!-- <span t-field="participation.cancellation_date"/>-->


      <!--CANCEL BUTTON -->

      <div>
        <!-- Only CONFIRMED state + upcoming participations can be canceled -->
        <t
                        t-if="participation.registration_state == 'confirmed' and participation.shift_id.start_time &gt;= now"
                    >
          <!-- Cancel shift participation form -->
          <form t-attf-action="/my/volunteer-shifts/#{participation.id}" method="post">
            <!-- t-att-$name (not a string, no "f")  -->
            <input name="csrf_token" type="hidden" t-att-value="request.csrf_token()" />
            <input name="action" type="hidden" value="cancel_participation" />
            <!-- t-att-$name (not a string, no "f")          -->
            <input
                                name="participation_id"
                                type="hidden"
                                t-att-value="participation.id"
                            />
            <button type="submit" class="btn btn-danger">Cancel participation</button>
          </form>
        </t>
      </div>
    </div>


    <div class="row">
      <strong>Shift timing: </strong>
      <!--? access: field group -->
      <div> Starts:
        <span t-field="participation.shift_start_time" />
      </div>
      <div> Ends:
        <span t-field="participation.shift_end_time" />
      </div>
    </div>

    <div> Company:
      <span t-field="participation.shift_id.company_id" />
    </div>
    <!-- !See how to fetch coordinator_id (in another model) -->
    <!-- <div> Coordinator:
    <span t-field="volunteer.coordinator_id"/>
    </div> -->
  </t>
</template>

</odoo>
