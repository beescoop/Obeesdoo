<odoo>
  
  <!--* "My Shifts" card  + counter in /my (Home portal page) -->
  
  <template id="portal_my_home"
  inherit_id="portal.portal_my_home"
  priority="100" name="Show My Shifts" customize_show="True">
  <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
    <t t-call="portal.portal_docs_entry">
      <t t-set="title">My Shifts</t>
      <!-- "Button" to redirect -->
      <t t-set="url" t-value="'/my/volunteer-shifts'" />
      <!-- Link to counter in Home (/my) -->
      <t t-set="placeholder_count" t-value="'volunteer_participation_count'" />
    </t>
  </xpath>
</template>

<!--* List of shifts participations for this volunteer (/my/volunteer-shifts)-->

<template id="my_shifts" name="My shifts">
  <!-- Template will inherit from Odoo’s default portal layout (header + footer)-->
  <t t-call="portal.portal_layout">
    
    <!--? anartemis test for title, see for order (accessibility)-->
    <h2> My shifts participations</h2>
    
    <!-- Cancellation confirmation message -->
    <div t-if="request.params.get('message') == 'canceled'" class="alert alert-success" role="alert">
      Your shift participation was canceled.
    </div>
    
    
    <!--!TO TEST: Cancellation error message -->
    <div t-if="request.params.get('message') == 'error'" class="alert alert-warning" role="alert">
      Could not cancel this shift participation.
    </div>
    <!-- Conditional rendering = only if there are shifts participations for usr, it's rendered -->
    <t t-if="participations" t-call="portal.portal_table">
      <!-- Accessibility: added "caption" [specifies the caption (or title) of a table, providing the table an accessible name or accessible description.]
      https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/caption + https://getbootstrap.com/docs/5.0/helpers/visually-hidden/-->
      <caption class="visually-hidden"> My shift participations</caption>
      <thead>
        <tr>"
          <!-- Accessibility: added th "scope" attribute => [specifies whether a header cell is a header for a column, row, or group of columns or rows
          Note: The scope attribute has no visual effect in ordinary web browsers, but can be used by screen readers] https://www.w3schools.com/tags/att_th_scope.asp -->
          <th scope="col">What shift?</th>
          <th scope="col">Start time and date</th>
          <th scope="col">End time and date</th>
          <th scope="col">Shift status (participation or existence)(Confirmed | Canceled)</th>
          <th scope="col">Shift registration type</th>
          <!--TODO when writing the "Register for a shift" form/controller : volunteer registered themselves via portal should be automatically set to "website"-->
          <th scope="col"> Registered for this shift on:</th>
          <!--*CANCEL SHIFT REGISTRATION / PARTICIPATION -->
          <!--TODO Add confirmation "Are you sure?" -->
          <th scope="col">Cancel shift participation</th>
          <!--Either volunteer canceled participation themselves via portal or admin canceled the shift itself -->
          <th scope="col">Shift (participation) canceled on:</th>
        </tr>
      </thead>
      <tbody>
        <!--* Shifts participations list for volunteer - for each) -->
        <tr t-foreach="participations" t-as="participation">
          
          <!--? SEE WHAT SLUG IS: "slug is used to generate a clean, user-friendly
          URL, based on a record name. sitemap_qs2dom is used to generate a domain based on route and
          query strings.
          In step 2, we created a Python generator function,sitemap_hostels(). This function will be
          called whenever a sitemap is generated. During the call, it will receive three arguments—the env
          Odoo environment, the rule route rule, and the qs query string. In the function, we generated a
          domain with sitemap_qs2dom. Then, we used the generated domain to search the hostel records,
          which are used to generate the location through the slug() method. With slug, you will get a
          user-friendly URL, such as /hostels/cambridge-1.-->
          
          <!-- <td> -->
          <!-- <a t-attf-href="/my/volunteer-shifts/{{slug(doc)}}"> -->
          <!-- <span t-field="doc.shift_id.display_name" /> -->
          <!-- </a> -->
          <!-- </td> -->
          
          <!--? btn-link that redirects to single shift participation details -->
          <td><a t-attf-href="/my/volunteer-shifts/#{participation.id}"><span t-field="participation.shift_id.display_name"/></a></td>
          <td><span t-field="participation.shift_start_time"/></td>
          <td><span t-field="participation.shift_end_time"/></td>
          <!-- Confirmed / canceled volunteer shift participation with BS classes -->
          <td><span t-field="participation.registration_state" t-attf-class="badge #{'bg-danger'if participation.registration_state == 'canceled' else 'bg-success'}"/></td>
          <td><span t-field="participation.registration_type"/></td>
          <td><span t-field="participation.registration_date"/></td>
          
          <!--* Cancel button / form -->
          <td>
            
            <!-- Only CONFIRMED state  + future participations can be canceled -->
            
            <t t-if="participation.registration_state == 'confirmed' and participation.shift_id.start_time &gt;= datetime.datetime.now()">
              
              <!-- POST form -->
              
              <form t-attf-action="/my/volunteer-shifts/#{participation.id}" method="post">
                
                
                <!-- CSRF token required for (POST req)form -->
                
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-danger">Cancel my participation</button>
              </form>
            </t>
          </td>
          <td><span t-field="participation.cancellation_date"/></td>
        </tr>
      </tbody>
    </t>
    <!--TODO: test -->
    <!-- Conditional rendering => if no shift participation for connected usr -->
    <t t-else="">
      <div class="alert alert-warning" role="alert">
        You are not registered for any shifts
        <!--? Q? : add a register button that redirects to available shifts? -->
      </div>
    </t>
    <!--TODO: test-->
    <!-- Page nav (only if 1+ page) -->
    <div class="o_portal_pager text-center" t-if="pager">
      <t t-call="portal.pager"/>
    </div>
  </t>
</template>

<!--* List of shifts participations detail for this volunteer (/my/volunteer-shifts)-->
<!--! BOOK DETAIL SHIFT - TO CHECK AND ADAPT FOR ACCESSIBILITY AND UX => SEMANTIC HTML, title order etc etc -->
<template id="volunteer_single_shift_participation" name="Shift participation detail">
  <t t-call="portal.portal_layout">
    <t t-call="portal.portal_record_layout">
      
      <!-- Card header-->
      <t t-set="card_header">
        <div class="row">
          <div class="col">
            <h5 class="text-truncate" t-field="participation.shift_id.display_name" /> 
          </div>
          <div class="col text-end">
            <span t-field="participation.registration_state" class="badge rounded-pill bg-info" title="Shift state"/>
          </div>
        </div>
      </t>
      
      <!--!TODO Card body: Accessibility replace divs & strong tags with dl / dt / dd -->
      <t t-set="card_body">
        <div class="row">
          <strong>Your name:</strong>
          <span t-field="participation.volunteer_id.partner_id.name"/>
        </div>
        <div class="row">
          <strong>Shift timing: </strong>
          <!--? access: field group -->
          <div> Starts:
            <span t-field="participation.shift_start_time"/>
          </div>
          <div> Ends:
            <span t-field="participation.shift_end_time"/>
          </div>
        </div>
        
        <div> Company:
          <span t-field="participation.shift_id.company_id"/>
        </div>
        <!-- !See how to fetch coordinator_id (in another model) -->
        <!-- <div> Coordinator:
          <span t-field="volunteer.coordinator_id"/>
        </div> -->
        
      </t>
      
    </t>
  </t>
</template>

<!--* Template UNAUTHORIZED page-->
<!--TODO: MAKE IT BETTER STYLISTICALLY - IF WE KEEP-->
<template id="portal_unauthorized_page" name="403-Forbidden/Unauthorized">
  <t t-call="portal.portal_layout">
    <div class="alert alert-danger text-center" role="alert">
      <h2 class="alert-heading">Unauthorized page</h2>
      <!-- Redirecting user to their own portal home page -->
      <a href="/my" class="btn btn-primary mt-5">Back to your portal</a>
    </div>
  </t>
</template>

</odoo>