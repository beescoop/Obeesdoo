<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Volunteer Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    id="volunteer_settings_block"
                    class="app_settings_block"
                    data-string="Volunteer Settings"
                    string="Volunteer Settings"
                    data-key="volunteer"
                    groups="volunteer.volunteer_group_admin"
                >
                    <h2>Generator settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">
                                     Shift number of occurrences
                                </span>
                                <div class="text-muted">
                                    Number of shift occurrences to maintain automatically
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label
                                            for="shift_nb_occurrence"
                                            string="Occurrences"
                                            class="col-3 col-lg-3 o_light_label"
                                        />
                                        <field
                                            name="shift_nb_occurrence"
                                            class="oe_inline"
                                            required="1"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
