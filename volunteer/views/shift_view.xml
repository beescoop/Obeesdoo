<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_form_shift" model="ir.ui.view">
        <field name="name">Shift Form</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <header>
                    <field name="state" invisible="True" />
                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable':True}"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Morning store opening"
                            />
                        </h1>
                    </div>
                    <group name="group_top">
                        <group name="group_left">
                            <label for="start_time" string="Period" />
                            <div class="o_row">
                                <field
                                    name="start_time"
                                    widget="daterange"
                                    nolabel="1"
                                    class="oe_inline"
                                    options="{'related_end_date': 'end_time'}"
                                />
                                <i
                                    class="fa fa-long-arrow-right mx-2"
                                    aria-label="Arrow icon"
                                    title="Arrow"
                                />
                                <field
                                    name="end_time"
                                    widget="daterange"
                                    nolabel="1"
                                    class="oe_inline"
                                    options="{'related_start_date': 'start_time'}"
                                />
                            </div>
                            <field name="tz" string="Timezone" />
                            <field name="type_id" />
                        </group>
                        <group name="group_right">
                            <field name="max_volunteer_nb" />
                            <field name="category_id" />
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name="company_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_tree_shift" model="ir.ui.view">
        <field name="name">Shift List</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="max_volunteer_nb" />
                <field name="category_id" />
                <field name="type_id" />
                <field name="tag_ids" widget="many2many_tags" />
                <field name="company_id" />
                <field name="tz" string="Timezone" readonly="1" optional="hide" />
                <field name="state" />
            </tree>
        </field>
    </record>
</odoo>
