<odoo>
    <record id="view_form_shift" model="ir.ui.view">
        <field name="name">Shift Form</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <header>
                    <field name="state" invisible="True" />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable':True}"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Morning store opening"
                            />
                        </h1>
                    </div>

                    <group name="group_top">
                        <group name="group_left">
                            <label for="start_time" string="Period" />
                            <div class="row d-flex">
                                <div class="col-4">
                                    <field
                                        name="start_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_end_date': 'end_time'}"
                                    />
                                </div>
                                <div class="col-1">
                                    <i
                                        class="fa fa-long-arrow-right"
                                        aria-label="Arrow icon"
                                        title="Arrow"
                                    />
                                </div>
                                <div class="col-4">
                                    <field
                                        name="end_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_start_date': 'start_time'}"
                                    />
                                </div>
                            </div>
                            <field name="tz" string="Timezone" />
                            <field name="type_id" />
                            <field name="max_volunteer_nb" />
                        </group>

                        <group name="group_right">
                            <field
                                name="coordinator_id"
                                options="{'no_quick_create':True,'no_create_edit':True}"
                            />
                            <field name="category_id" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                            <field name="company_id" />
                        </group>
                    </group>

                    <notebook>
                        <page
                            name="page_participation"
                            string="Participating Volunteers"
                        >
                            <field name="volunteer_participation_ids">
                                <tree editable="bottom" delete="false">
                                    <field
                                        name="volunteer_id"
                                        options="{'no_quick_create':True,'no_create_edit':True}"
                                    />
                                    <field name="registration_date" readonly="1" />
                                    <field name="registration_type" />
                                    <field name="registration_state" />
                                    <field name="cancellation_date" readonly="1" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_tree_shift" model="ir.ui.view">
        <field name="name">Shift List</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="tz" string="Timezone" readonly="1" optional="hide" />
                <field name="max_volunteer_nb" />
                <field name="category_id" />
                <field name="type_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="remaining_slots" />
                <field name="coordinator_id" />
                <field name="company_id" />
                <field name="state" />
            </tree>
        </field>
    </record>
</odoo>
