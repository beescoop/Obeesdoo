<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shift_participation_form_view" model="ir.ui.view">
        <field name="name">Shift Participation Form</field>
        <field name="model">volunteer.shift.participation</field>
        <field name="arch" type="xml">
            <form string="Shift Participation">
                <header>
                    <field name="registration_state" invisible="True" />
                    <field
                        name="registration_state"
                        widget="statusbar"
                        options="{'clickable':True}"
                        groups="volunteer.volunteer_group_admin"
                    />
                </header>
                <sheet>
                    <div class="o_row">
                        <div class="oe_title">
                            <h2>
                                <field
                                    name="volunteer_id"
                                    placeholder="Select volunteer to assign"
                                />
                            </h2>
                        </div>
                        <div class="oe_title">
                            <h2>
                                <field
                                    name="shift_id"
                                    placeholder="Select Shift for assignation"
                                />
                            </h2>
                        </div>
                    </div>
                    <group name="group_top">
                        <group name="group_left">
                            <field name="replaced_volunteer_id" />
                        </group>
                        <group name="group_right">
                            <field name="registration_type" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
