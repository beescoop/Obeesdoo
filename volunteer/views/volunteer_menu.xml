<odoo>
    <!-- Volunteer App Menu -->
    <menuitem id="menu_volunteer" name="Volunteer" />

    <!-- Shift menu -->
    <record id="action_volunteer_shift" model="ir.actions.act_window">
        <field name="name">Volunteer Shift</field>
        <field name="res_model">volunteer.shift</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem
        id="menu_volunteer_shift"
        name="Shifts"
        parent="menu_volunteer"
        sequence="10"
        action="action_volunteer_shift"
    />

    <!-- Volunteer Menu -->
    <record id="action_volunteer_volunteer" model="ir.actions.act_window">
        <field name="name">Volunteer</field>
        <field name="res_model">volunteer.volunteer</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem
        id="menu_volunteer_volunteer"
        name="Volunteers"
        parent="menu_volunteer"
        sequence="20"
        action="action_volunteer_volunteer"
    />

    <!-- Configuration Menu -->
    <menuitem
        id="menu_volunteer_configuration"
        name="Configuration"
        parent="menu_volunteer"
        sequence="40"
        groups="volunteer.volunteer_group_admin"
    />
    <!-- Category Configuration Submenu -->
    <record id="action_volunteer_shift_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">volunteer.shift.category</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="menu_volunteer_shift_category"
        name="Categories"
        action="action_volunteer_shift_category"
        parent="menu_volunteer_configuration"
    />
    <!-- Type Configuration Submenu -->
    <record id="action_volunteer_shift_type" model="ir.actions.act_window">
        <field name="name">Types</field>
        <field name="res_model">volunteer.shift.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="menu_volunteer_shift_type"
        name="Types"
        action="action_volunteer_shift_type"
        parent="menu_volunteer_configuration"
    />
    <!-- Tag Configuration Submenu -->
    <record id="action_volunteer_shift_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">volunteer.shift.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="menu_volunteer_shift_tag"
        name="Tags"
        action="action_volunteer_shift_tag"
        parent="menu_volunteer_configuration"
    />
</odoo>
