<odoo>
    <!-- Volunteer App Menu -->
    <menuitem id="menu_volunteer" name="Volunteer" action="action_volunteer_shift" />
    <!-- Volunteer Menu -->
    <menuitem
        id="menu_volunteer_volunteer"
        name="Volunteers"
        parent="menu_volunteer"
        sequence="10"
        action="action_volunteer_volunteer"
    />
    <!-- Shift menu -->
    <menuitem
        id="menu_volunteer_shift"
        name="Shifts"
        parent="menu_volunteer"
        sequence="20"
        action="action_volunteer_shift"
    />
    <!-- Configuration Menu -->
    <menuitem
        id="menu_volunteer_configuration"
        name="Configuration"
        parent="menu_volunteer"
        sequence="90"
        groups="volunteer.volunteer_group_admin"
    >
        <!-- Shift Configuration Separator -->
        <menuitem
            id="shift_configuration_menu"
            name="Shifts"
            sequence="1"
            groups="volunteer.volunteer_group_admin"
        >
            <!-- Category Submenu -->
            <menuitem
                id="menu_volunteer_shift_category"
                name="Categories"
                action="action_volunteer_shift_category"
            />
            <!-- Type Submenu -->
            <menuitem
                id="menu_volunteer_shift_type"
                name="Types"
                action="action_volunteer_shift_type"
            />
            <!-- Tag Submenu -->
            <menuitem
                id="menu_volunteer_shift_tag"
                name="Tags"
                action="action_volunteer_shift_tag"
            />
        </menuitem>
    </menuitem>
</odoo>
