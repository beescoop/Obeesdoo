<odoo>
    <!-- Volunteer App Menu -->
    <menuitem
        id="volunteer_menu"
        name="Volunteer"
        action="volunteer_shift_action_future"
    />
    <!-- Volunteer Menu -->
    <menuitem
        id="volunteer_volunteer_menu"
        name="Volunteers"
        parent="volunteer_menu"
        sequence="10"
        action="volunteer_volunteer_action"
    />
    <!-- Shift menu -->
    <menuitem
        id="volunteer_shift_menu"
        name="Shifts"
        parent="volunteer_menu"
        sequence="20"
        action="volunteer_shift_action_future"
    />
    <!-- Shift Generator menu -->
    <menuitem
        id="volunteer_shift_generator_menu"
        name="Shifts Generators"
        parent="volunteer_menu"
        sequence="30"
        action="volunteer_shift_generator_action"
    />
    <!-- Shift Registration menu -->
    <menuitem
        id="volunteer_shift_registration_menu"
        name="Registrations"
        parent="volunteer_menu"
        sequence="80"
        groups="volunteer.volunteer_group_admin"
    />
        <!-- Shift Participation submenu -->
        <menuitem
        id="volunteer_shift_participation_menu"
        name="Participation"
        parent="volunteer_shift_registration_menu"
        sequence="10"
        action="volunteer_shift_participation_action"
        groups="volunteer.volunteer_group_admin"
    />
        <!-- Shift Subscription submenu -->
        <menuitem
        id="volunteer_shift_recurrent_subscription_menu"
        name="Subscription"
        parent="volunteer_shift_registration_menu"
        sequence="20"
        action="volunteer_shift_recurrent_subscription_action"
        groups="volunteer.volunteer_group_admin"
    />
    <!-- Configuration Menu -->
    <menuitem
        id="volunteer_configuration_menu"
        name="Configuration"
        parent="volunteer_menu"
        sequence="90"
        groups="volunteer.volunteer_group_admin"
    >
        <!-- Shift Configuration Separator -->
        <menuitem
            id="volunteer_configuration_shift_separator_menu"
            name="Shifts"
            sequence="1"
            groups="volunteer.volunteer_group_admin"
        >
            <!-- Category Submenu -->
            <menuitem
                id="volunteer_shift_category_menu"
                name="Categories"
                action="volunteer_shift_category_action"
            />
            <!-- Type Submenu -->
            <menuitem
                id="volunteer_shift_type_menu"
                name="Types"
                action="volunteer_shift_type_action"
            />
            <!-- Tag Submenu -->
            <menuitem
                id="volunteer_shift_tag_menu"
                name="Tags"
                action="volunteer_shift_tag_action"
            />
        </menuitem>
        <!-- Skill Configuration Separator -->
        <menuitem
            id="volunteer_configuration_skill_separator_menu"
            name="Skills"
            sequence="10"
            groups="volunteer.volunteer_group_admin"
        >
            <!-- Skill Configuration Submenu -->
            <menuitem
                id="menu_volunteer_shift_skill"
                name="Skills"
                action="volunteer_skill_action"
            />
            <!-- Skill Category Configuration Submenu -->
            <menuitem
                id="menu_volunteer_shift_skill_category"
                name="Categories"
                action="volunteer_skill_category_action"
            />
        </menuitem>
    </menuitem>
</odoo>
