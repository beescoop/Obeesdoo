<odoo>
    <record id="volunteer_shift_generator_view_form" model="ir.ui.view">
        <field name="name">Shift Generator Form</field>
        <field name="model">volunteer.shift.recurrent.generator</field>
        <field name="arch" type="xml">
            <form string="Shift Generator">
                <header>
                    <field name="state" invisible="True" />
                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable':True}"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Morning store opening"
                            />
                        </h1>
                    </div>
                    <separator string="Shift Generator Configuration" colspan="4" />
                    <group>
                        <group>
                            <field name="until_date" />
                        </group>
                        <group>
                            <group>
                                <field name="interval_type" />
                            </group>
                            <group>
                                <field name="interval" />
                            </group>
                        </group>
                    </group>
                    <separator string="Shift Configuration" colspan="4" />
                    <group>
                        <group name="group_left">
                            <label for="start_time" string="Period" />
                            <div class="row d-flex">
                                <div class="col-4">
                                    <field
                                        name="start_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_end_date': 'end_time'}"
                                    />
                                </div>
                                <div class="col-1">
                                    <i
                                        class="fa fa-long-arrow-right"
                                        aria-label="Arrow icon"
                                        title="Arrow"
                                    />
                                </div>
                                <div class="col-4">
                                    <field
                                        name="end_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_start_date': 'start_time'}"
                                    />
                                </div>
                            </div>
                            <field name="tz" string="Timezone" />
                            <field name="type_id" options="{'no_create':True}" />
                            <field name="max_volunteer_nb" />
                        </group>

                        <group name="group_right">
                            <field name="coordinator_id" options="{'no_create':True}" />
                            <field name="category_id" options="{'no_create':True}" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field':'color','no_create':True}"
                            />
                            <field name="company_id" />
                        </group>
                    </group>

                    <notebook>
                        <page name="page_subscription" string="Subscribed Volunteers">
                            <field
                                name="volunteer_subscription_ids"
                                attrs="{'readonly': [('state', '=', 'canceled')]}"
                            >
                                <tree editable="bottom" delete="false">
                                    <field
                                        name="volunteer_id"
                                        options="{'no_create':True}"
                                    />
                                    <field
                                        name="start_date"
                                        widget="date"
                                        options="{'related_end_date': 'end_date'}"
                                    />
                                    <field
                                        name="end_date"
                                        widget="date"
                                        options="{'related_start_date': 'start_date'}"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="volunteer_shift_generator_view_tree" model="ir.ui.view">
        <field name="name">Shift Generator List</field>
        <field name="model">volunteer.shift.recurrent.generator</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="until_date" />
                <field name="interval_type" />
                <field name="interval" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="tz" string="Timezone" readonly="1" optional="hide" />
                <field name="max_volunteer_nb" />
                <field name="category_id" />
                <field name="type_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="coordinator_id" />
                <field name="company_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-warning="state  == 'canceled'"
                />
            </tree>
        </field>
    </record>

    <record id="volunteer_shift_generator_action" model="ir.actions.act_window">
        <field name="name">Shift Generator</field>
        <field name="res_model">volunteer.shift.recurrent.generator</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
