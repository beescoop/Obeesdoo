<odoo>
    <record id="volunteer_shift_view_form" model="ir.ui.view">
        <field name="name">Shift Form</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">
                <header>
                    <field name="state" invisible="True" />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable':True}"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Morning store opening"
                            />
                        </h1>
                    </div>

                    <group name="group_top">
                        <group name="group_left">
                            <label for="start_time" string="Period" />
                            <div class="row d-flex">
                                <div class="col-4">
                                    <field
                                        name="start_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_end_date': 'end_time'}"
                                    />
                                </div>
                                <div class="col-1">
                                    <i
                                        class="fa fa-long-arrow-right"
                                        aria-label="Arrow icon"
                                        title="Arrow"
                                    />
                                </div>
                                <div class="col-4">
                                    <field
                                        name="end_time"
                                        widget="daterange"
                                        nolabel="1"
                                        class="oe_inline"
                                        options="{'related_start_date': 'start_time'}"
                                    />
                                </div>
                            </div>
                            <field name="tz" string="Timezone" />
                            <field name="type_id" options="{'no_create':True}" />
                            <field name="max_volunteer_nb" />
                        </group>

                        <group name="group_right">
                            <field name="coordinator_id" options="{'no_create':True}" />
                            <field name="category_id" options="{'no_create':True}" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field':'color','no_create':True}"
                            />
                            <field name="company_id" />
                        </group>
                    </group>

                    <notebook>
                        <page
                            name="page_participation"
                            string="Participating Volunteers"
                        >
                            <field name="volunteer_participation_ids">
                                <tree editable="bottom" delete="false">
                                    <field
                                        name="volunteer_id"
                                        options="{'no_create':True}"
                                    />
                                    <field name="registration_date" readonly="1" />
                                    <field name="registration_type" />
                                    <field name="registration_state" />
                                    <field name="cancellation_date" readonly="1" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="volunteer_shift_view_tree" model="ir.ui.view">
        <field name="name">Shift List</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="tz" string="Timezone" readonly="1" optional="hide" />
                <field name="max_volunteer_nb" />
                <field name="category_id" />
                <field name="type_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="remaining_slots" />
                <field name="coordinator_id" />
                <field name="company_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-warning="state  == 'canceled'"
                />
            </tree>
        </field>
    </record>

    <record id="volunteer_shift_view_calendar" model="ir.ui.view">
        <field name="name">Shift Calendar</field>
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <calendar
                string="Shifts"
                date_start="start_time"
                date_stop="end_time"
                color="type_id"
            >
                <field name="max_volunteer_nb" />
                <field name="type_id" />
                <field name="category_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="remaining_slots" />
                <field name="coordinator_id" />
                <field name="company_id" />
                <field name="state" />
            </calendar>
        </field>
    </record>

    <record id="volunteer_shift_view_search" model="ir.ui.view">
        <field name="model">volunteer.shift</field>
        <field name="arch" type="xml">
            <search string="Shift Search">
                <field
                    name="tag_ids"
                    string="Tags"
                    filter_domain="[('tag_ids', 'ilike', self)]"
                />
                <field
                    name="volunteer_ids"
                    filter_domain="[('volunteer_ids', 'ilike', self)]"
                    string="Volunteer"
                />
                <field
                    name="category_id"
                    filter_domain="[('category_id.name', 'ilike', self)]"
                    string="Category"
                />
                <field
                    name="type_id"
                    filter_domain="[('type_id.name', 'ilike', self)]"
                    string="Type"
                />

                <filter
                    name="filter_today"
                    string="Today"
                    domain="[('start_time', '>=', context_today().strftime('%Y-%m-%d 00:00:00')),('start_time','&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"
                />
                <filter
                    name="filter_future"
                    string="Future"
                    domain="[('start_time', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    name="filter_past"
                    string="Past"
                    domain="[('start_time','&lt;', context_today().strftime('%Y-%m-%d 23:59:59'))]"
                />
                <separator />
                <filter
                    name="filter_next_7_days"
                    string="Next 7 days"
                    domain="[('start_time', '&lt;=', (context_today()+datetime.timedelta(days=7)).strftime('%Y-%m-%d 23:59:59')),('start_time','>=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    name="filter_last_7_days"
                    string="Last 7 days"
                    domain="[('start_time', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')),('start_time','>=', (context_today()- datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    name="filter_next_30_days"
                    string="Next 30 days"
                    domain="[('start_time', '&lt;=', (context_today()+datetime.timedelta(days=30)).strftime('%Y-%m-%d 23:59:59')),('start_time','>=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <separator />
                <filter name="filter_date" string="Period" date="start_time" />

                <searchpanel>
                    <field name="stage_id" string="Stage" select="multi" />
                    <field name="category_id" string="Category" select="multi" />
                    <field name="type_id" string="Type" select="multi" />
                </searchpanel>

                <group expand="1" string="Group By">
                    <filter
                        name="start_time"
                        string="Date"
                        context="{'group_by':'start_time'}"
                    />
                    <filter
                        name="category"
                        string="Category"
                        context="{'group_by':'category_id'}"
                    />
                    <filter
                        name="type"
                        string="Type"
                        context="{'group_by':'type_id'}"
                    />
                    <filter name="tag" string="Tag" context="{'group_by':'tag_ids'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="volunteer_shift_action_future" model="ir.actions.act_window">
        <field name="name">Shift</field>
        <field name="res_model">volunteer.shift</field>
        <field name="context">{"search_default_filter_future": 1}</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
    </record>
</odoo>
