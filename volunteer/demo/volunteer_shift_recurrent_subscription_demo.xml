<odoo>
    <!-- Canceled subscription (active=False) -->
    <record
        id="volunteer_subscription_demo_emma_canceled"
        model="volunteer.shift.recurrent.subscription"
    >
        <field name="volunteer_id" ref="volunteer_demo_emma" />
        <field name="generator_id" ref="volunteer_generator_demo_friday_opening" />
        <field
            name="start_date"
            eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')"
        />
        <field name="end_date" eval="datetime.now().strftime('%Y-%m-%d')" />
        <field name="active" eval="False" />
    </record>
    <!-- Ongoing subscription -->
    <record
        id="volunteer_subscription_demo_emma"
        model="volunteer.shift.recurrent.subscription"
    >
        <field name="volunteer_id" ref="volunteer_demo_emma" />
        <field name="generator_id" ref="volunteer_generator_demo_friday_opening" />
        <field
            name="start_date"
            eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')"
        />
    </record>
    <!-- Upcoming subscription -->
    <record
        id="volunteer_subscription_demo_jean"
        model="volunteer.shift.recurrent.subscription"
    >
        <field name="volunteer_id" ref="volunteer_demo_jean" />
        <field name="generator_id" ref="volunteer_generator_demo_friday_opening" />
        <field
            name="start_date"
            eval="(datetime.now() + timedelta(days=7)).strftime('%Y-%m-%d')"
        />
        <field
            name="end_date"
            eval="(datetime.now() + timedelta(days=14)).strftime('%Y-%m-%d')"
        />
    </record>
    <!-- Finished subscription -->
    <record
        id="volunteer_subscription_demo_john"
        model="volunteer.shift.recurrent.subscription"
    >
        <field name="volunteer_id" ref="volunteer_demo_john" />
        <field name="generator_id" ref="volunteer_generator_demo_friday_opening" />
        <field
            name="start_date"
            eval="(datetime.now() - timedelta(days=14)).strftime('%Y-%m-%d')"
        />
        <field
            name="end_date"
            eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')"
        />
    </record>
</odoo>
