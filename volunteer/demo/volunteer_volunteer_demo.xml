<odoo>
    <record id="volunteer_partner_demo_a" model="res.partner">
        <field name="name">Volunteer A</field>
        <field name="street">123 exemple street</field>
        <field name="zip">1190</field>
        <field name="city">Forest</field>
        <field name="country_id" ref="base.be" />
        <field name="phone">123456789</field>
        <field name="email">vol_a@exemple.com</field>
    </record>
    <record id="volunteer_demo_a" model="volunteer.volunteer">
        <field name="partner_id" ref="volunteer_partner_demo_a" />
        <field
            name="skill_ids"
            eval="[(6, 0, [ref('volunteer_skill_demo_french'), ref('volunteer_skill_demo_B_license')])]"
        />
    </record>

