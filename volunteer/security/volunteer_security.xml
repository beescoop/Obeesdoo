<odoo>
    <!-- Security groups -->
    <data>
        <!-- Volunteer User Group -->
        <record id="volunteer_group_user" model="res.groups">
            <field name="name">Volunteer</field>
            <field name="category_id" ref="base.module_category_volunteer_management" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- Volunteer Manager Group -->
        <record id="volunteer_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="base.module_category_volunteer_management" />
            <field name="implied_ids" eval="[(4, ref('volunteer_group_user'))]" />
        </record>

        <!-- Volunteer Admin Group -->
        <record id="volunteer_group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="base.module_category_volunteer_management" />
            <field name="implied_ids" eval="[(4, ref('volunteer_group_manager'))]" />
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
        </record>
    </data>

    <data>
        <!-- Record rules -->
        <record id="shift_company_rule" model="ir.rule">
            <field name="name">Volunteer shift company access</field>
            <field name="model_id" ref="model_volunteer_shift" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="shift_category_company_rule" model="ir.rule">
            <field name="name">Volunteer shift category company access</field>
            <field name="model_id" ref="model_volunteer_shift_category" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="shift_type_company_rule" model="ir.rule">
            <field name="name">Volunteer shift type company access</field>
            <field name="model_id" ref="model_volunteer_shift_type" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="shift_tag_company_rule" model="ir.rule">
            <field name="name">Volunteer shift tag company access</field>
            <field name="model_id" ref="model_volunteer_shift_tag" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="volunteer_company_rule" model="ir.rule">
            <field name="name">Volunteer company access</field>
            <field name="model_id" ref="model_volunteer_volunteer" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
