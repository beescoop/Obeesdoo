<odoo>

    <!-- Add buttons to change shift -->
    <template
        id="my_shift_next_shifts_change"
        name="My shifts: Next Shift with change button"
        inherit_id="shift_portal.my_shift_next_shifts"
    >
        <xpath expr="//div[hasclass('card-body', 'clearfix')]" position="inside">
            <a
                t-if="request.env.user.partner_id.working_mode == 'regular'
                    and shift.state != 'cancel'
                    and not shift.is_compensation
                    and is_shift_change_enabled
                    and shift.id"
                t-attf-href="/my/shift/change/{{ shift.id }}"
                class="btn btn-primary btn-sm ml-2"
            >
                Change Shift
            </a>
        </xpath>
    </template>

</odoo>
